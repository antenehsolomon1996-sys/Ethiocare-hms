{
  "name": "NurseTask",
  "type": "object",
  "properties": {
    "visit_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "injection",
        "iv_treatment",
        "procedure",
        "vitals",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "completed_by": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "visit_id",
    "patient_id",
    "task_type"
  ]
}