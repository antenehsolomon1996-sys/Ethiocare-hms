{
  "name": "Patient",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Auto-generated patient ID"
    },
    "full_name": {
      "type": "string",
      "description": "Patient full name"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female"
      ]
    },
    "age": {
      "type": "number"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "registration_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "full_name",
    "gender",
    "phone"
  ]
}