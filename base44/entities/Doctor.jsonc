{
  "name": "Doctor",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "specialty": {
      "type": "string",
      "enum": [
        "General Practice",
        "Cardiology",
        "Pediatrics",
        "Surgery",
        "Internal Medicine",
        "Obstetrics & Gynecology",
        "Orthopedics",
        "Neurology",
        "Dermatology",
        "Ophthalmology",
        "ENT",
        "Psychiatry",
        "Radiology",
        "Anesthesiology",
        "Emergency Medicine",
        "Oncology",
        "Urology",
        "Nephrology",
        "Endocrinology",
        "Pulmonology",
        "Other"
      ]
    },
    "doctor_type": {
      "type": "string",
      "enum": [
        "General Practitioner",
        "Specialist",
        "Consultant",
        "Resident"
      ],
      "default": "General Practitioner"
    },
    "license_number": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "off_duty",
        "on_leave"
      ],
      "default": "available"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "on_leave"
      ],
      "default": "active"
    },
    "staff_id": {
      "type": "string",
      "description": "Reference to Staff entity"
    }
  },
  "required": [
    "full_name",
    "specialty",
    "doctor_type"
  ]
}