{
  "name": "Visit",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to patient record ID"
    },
    "patient_name": {
      "type": "string"
    },
    "visit_date": {
      "type": "string",
      "format": "date"
    },
    "queue_number": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "with_doctor",
        "lab_pending",
        "lab_paid",
        "lab_processing",
        "lab_complete",
        "pharmacy",
        "completed",
        "cancelled"
      ],
      "default": "waiting"
    },
    "assigned_doctor": {
      "type": "string",
      "description": "Doctor full name (display)"
    },
    "assigned_doctor_id": {
      "type": "string",
      "description": "Reference to Doctor entity ID \u2014 used for filtering"
    },
    "billing_completed": {
      "type": "boolean",
      "default": false,
      "description": "Set to true when registration payment is confirmed by billing"
    },
    "consultation_completed": {
      "type": "boolean",
      "default": false,
      "description": "Set to true when doctor saves final diagnosis and completes consultation"
    },
    "symptoms": {
      "type": "string"
    },
    "examination_notes": {
      "type": "string"
    },
    "diagnosis": {
      "type": "string"
    },
    "disease": {
      "type": "string"
    },
    "treatment_plan": {
      "type": "string"
    },
    "final_diagnosis": {
      "type": "string"
    },
    "final_treatment": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "follow_up_notes": {
      "type": "string"
    },
    "registration_fee_paid": {
      "type": "boolean",
      "default": false
    },
    "department": {
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "patient_name"
  ]
}