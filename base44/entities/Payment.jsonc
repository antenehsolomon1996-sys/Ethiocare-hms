{
  "name": "Payment",
  "type": "object",
  "properties": {
    "visit_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "registration",
        "consultation",
        "laboratory",
        "procedure",
        "injection",
        "medicine",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "mobile_banking",
        "card",
        "insurance"
      ],
      "default": "cash"
    },
    "receipt_number": {
      "type": "string"
    },
    "reference_id": {
      "type": "string",
      "description": "Primary link to the originating order (medication order, lab order, or prescription)"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "lab_order",
        "prescription",
        "service",
        "registration",
        "medication_order"
      ]
    },
    "cashier_name": {
      "type": "string"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "doctor_name": {
      "type": "string",
      "description": "Doctor who created the linked order"
    },
    "doctor_id": {
      "type": "string"
    },
    "medication_order_id": {
      "type": "string",
      "description": "Primary relationship key to MedicationOrder entity"
    },
    "medication_name": {
      "type": "string"
    },
    "dosage": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "frequency": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "description": "Administration route (medicine, injection, iv_treatment, etc.)"
    },
    "order_notes": {
      "type": "string",
      "description": "Doctor's instructions for the order"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "waived",
        "cancelled",
        "administered",
        "completed"
      ],
      "description": "Mirrors the MedicationOrder workflow status for cross-entity sync"
    }
  },
  "required": [
    "patient_id",
    "payment_type",
    "amount"
  ]
}