{
  "name": "Medicine",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "generic_name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "dosage_form": {
      "type": "string",
      "enum": [
        "Tablet",
        "Capsule",
        "Syrup",
        "Injection",
        "Ointment",
        "Drops",
        "Inhaler",
        "Cream",
        "Suppository",
        "Other"
      ]
    },
    "strength": {
      "type": "string",
      "description": "e.g. 500mg, 5mg/ml"
    },
    "barcode": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "batch_number": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "purchase_price": {
      "type": "number",
      "default": 0
    },
    "unit_price": {
      "type": "number",
      "description": "Selling price",
      "default": 0
    },
    "tax": {
      "type": "number",
      "default": 0,
      "description": "Tax percentage"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "min_stock": {
      "type": "number",
      "default": 10,
      "description": "Minimum stock / reorder level"
    },
    "max_stock": {
      "type": "number",
      "default": 100
    },
    "unit": {
      "type": "string",
      "description": "e.g. pieces, boxes, bottles",
      "default": "pieces"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "manufacturing_date": {
      "type": "string",
      "format": "date"
    },
    "storage_location": {
      "type": "string"
    },
    "prescription_required": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "in_stock",
        "low_stock",
        "out_of_stock",
        "expired"
      ],
      "default": "in_stock"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Medicine image URL"
    }
  },
  "required": [
    "name",
    "quantity",
    "unit_price"
  ]
}