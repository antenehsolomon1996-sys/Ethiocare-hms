{
  "name": "Staff",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Hospital email used for login (auto-generated)"
    },
    "username": {
      "type": "string",
      "description": "Auto-generated username from full name"
    },
    "personal_email": {
      "type": "string",
      "description": "Personal email for notifications (optional, used if hospital email is not real)"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "receptionist",
        "doctor",
        "nurse",
        "lab_technician",
        "pharmacist",
        "accountant"
      ]
    },
    "department": {
      "type": "string"
    },
    "specialization": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "retired"
      ],
      "default": "active"
    },
    "activation_code": {
      "type": "string",
      "description": "Unique activation code for first-time login, generated by the Owner"
    },
    "activation_used": {
      "type": "boolean",
      "default": false,
      "description": "True after the staff member has used the activation code to create their account"
    },
    "password_set": {
      "type": "boolean",
      "default": false,
      "description": "True after the staff member has created their password and completed activation"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last successful login"
    }
  },
  "required": [
    "full_name",
    "email",
    "role"
  ]
}