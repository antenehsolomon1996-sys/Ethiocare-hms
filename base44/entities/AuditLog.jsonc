{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "user_name": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "login",
        "logout",
        "create",
        "update",
        "delete",
        "view",
        "print",
        "approve",
        "reject"
      ]
    },
    "module": {
      "type": "string",
      "description": "e.g. Patient, Visit, Lab, Prescription, Billing"
    },
    "description": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "record_name": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "user_name",
    "action",
    "module"
  ]
}