{
  "name": "MedicationOrder",
  "type": "object",
  "properties": {
    "visit_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "doctor_id": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "medicine",
        "injection",
        "iv_treatment",
        "medical_supply",
        "other"
      ],
      "default": "medicine"
    },
    "item_name": {
      "type": "string",
      "description": "Medicine name, injection name, or supply name"
    },
    "dosage": {
      "type": "string"
    },
    "frequency": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "total_price": {
      "type": "number",
      "default": 0
    },
    "instructions": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "routine",
        "urgent",
        "stat"
      ],
      "default": "routine"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "waived",
        "cancelled"
      ],
      "default": "pending_payment",
      "description": "Controls nurse visibility \u2014 visible to nurses only when paid or waived"
    },
    "administration_status": {
      "type": "string",
      "enum": [
        "awaiting_payment",
        "pending",
        "in_progress",
        "completed",
        "refused"
      ],
      "default": "awaiting_payment",
      "description": "Nurse administration workflow status"
    },
    "payment_id": {
      "type": "string",
      "description": "Reference to Payment entity"
    },
    "receipt_number": {
      "type": "string"
    },
    "paid_by": {
      "type": "string"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "administered_by": {
      "type": "string"
    },
    "administered_date": {
      "type": "string",
      "format": "date"
    },
    "administration_notes": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "visit_id",
    "patient_id",
    "patient_name",
    "order_type",
    "item_name"
  ]
}